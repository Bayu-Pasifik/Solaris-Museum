# Dependencies and build output
node_modules/
dist/
__pycache__/
*.tsbuildinfo

# Secrets and local settings
.env*
*.local

# Game assets and data (owned by Kuro Games, never commit)
assets-raw/
work/
tools/
public/models/
public/data/
public/art/
*.zip
*.uemodel
